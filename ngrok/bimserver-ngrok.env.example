# Copy to bimserver-ngrok.env (git-ignored) and adjust. Every setting is optional.

# Admin account created on first start. Leave the password empty to have a random one generated
# and saved in bimserver-ngrok.env. It must be at least 16 characters.
BIMSERVER_ADMIN_USERNAME=admin@bimserver.org
BIMSERVER_ADMIN_PASSWORD=

# Your reserved ngrok domain (free accounts get one), e.g. example-name.ngrok-free.app.
# Without it every start gets a new random URL.
NGROK_DOMAIN=

# Local port, data directory (relative to BimServerJar/) and Java heap
BIMSERVER_PORT=8080
BIMSERVER_HOME=home-public
BIMSERVER_XMX=4g
BIMSERVER_NAME=BIMserver
